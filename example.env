# Path to the MoonSec Deobfuscator executable (same one the original Discord
# bot used). Build it from https://github.com/tupsutumppu/MoonsecDeobfuscator
MOON_EXECUTABLE=C:\Path\To\MoonsecDeobfuscator.exe

# Name of the decompression script (usually decom.lua, already included here)
DECOM_SCRIPT=decom.lua

# Optional
MAX_UPLOAD_MB=5
FLASK_SECRET_KEY=change-me
PORT=5000
